  },
  "liquidsoap": {
    "telnetHost": "127.0.0.1",
    "telnetPort": 1234
  },
  "plex": {
    "baseUrl": "TBD - use the https://<ip-with-dashes>.<hash>.plex.direct:32400 hostname from Settings > Network, not the raw IP, or TLS cert validation will fail",
    "token": "CHANGE_ME",
    "librarySectionId": "TBD",
    "scrobbleEnabled": true
  },
  "musicLibrary": {
    "plexPathPrefix": "TBD",
    "localMountPath": "/mnt/plex-music"
  },
  "djDrops": {
    "gain": 2.0
  },
  "weather": {
    "url": "https://api.open-meteo.com/v1/forecast",
    "latitude": "TBD",
    "longitude": "TBD",
    "timezone": "TBD"
  },
  "schedule": {
    "scriptLeadTimeMinutes": 120,
    "scriptCheckIntervalMinutes": 15,
    "directLeadTimeMinutes": 15,
    "directCheckIntervalMinutes": 2,
    "prewarmCheckIntervalMinutes": 15,
    "prewarmHorizonMinutes": 1440,
    "nowPlayingCheckIntervalMinutes": 0.1,
    "scheduleWatchIntervalMinutes": 1,
    "maxCatchUpMinutes": 10,
    "minLeadTimeMinutes": 30
  },
  "filler": {
    "poolSize": 200,
    "regenerateIntervalMinutes": 360,
    "maxTrackDurationSeconds": 600,
    "rotation": {
      "maxTracksPerArtist": 30,
      "maxTracksPerArtistAlbum": 5,
      "weightWindowDays": 7,
      "noveltyDays": 7,
      "noveltyBoost": 3
    },
    "clockwheel": {
      "pools": {
        "chill": {
          "genres": [
            "chillout",
            "ambient"
          ],
          "excludeKeywords": [
            "metal"
          ]
        }
      },
      "steps": [
        {
          "pool": "chill",
          "count": 1
        },
        {
          "pool": "rotation",
          "count": 4
        }
      ],
      "dayparts": [
        {
          "from": "22:00",
          "to": "24:00",
          "steps": [
            {
              "pool": "chill",
              "count": 2
            },
            {
              "pool": "rotation",
              "count": 2
            }
          ]
        }
      ]
    }
  },
  "shows": {
    "repeatWindowDays": 30,
    "maxTrackDurationSeconds": 300,
    "minTrackDurationSeconds": 120,
    "inventory": {
      "minSpeechSegments": 3,
      "minTracksPer30Minutes": 6
    }
  },
  "smartBlocks": [
    {
      "name": "friday-night-jazz",
      "criteria": {
        "genre": "Jazz",
        "excludeKeywords": [
          "live"
        ]
      },
      "limit": {
        "count": 12
      },
      "order": "random"
    },
    {
      "name": "petkova-noc-jazz",
      "criteria": {
        "genre": "Jazz",
        "maxTrackDurationSeconds": 360
      },
      "limit": {
        "minutes": 45
      },
      "order": "newest",
      "overflow": false
    }
  ],
  "cleanup": {
    "retentionDays": 7,
    "intervalMinutes": 360
  },
  "backup": {
    "dir": "TBD - absolute path to a folder where the daily backup is written; the backup covers ALL irreplaceable state (station.json, show-descriptions/, prompts.json, requests.jsonl, polls.json, push/ incl. the VAPID private key, history ledgers, show-logos/, imaging clips, the track_ratingkeys/autocue caches AND config.json with its plaintext passwords) -- so the backup dir itself must be protected (owner-only) and ideally off-box: on the same disk as dataDir it protects against a bad edit, not against disk failure (see deploy/ubuntu/DEPLOYMENT_GUIDE.md); retentionDays: 30 = rotate away day dirs older than 30 days, 0 = keep forever",
    "intervalMinutes": 1440,
    "retentionDays": 30
  },
  "archive": {
    "enabled": false,
    "bitrate": 128,
    "retentionDays": 30
  },
  "analytics": {
    "sampleIntervalMinutes": 1,
    "maxEntries": 43200,
    "impactWindowHours": 168,
    "impactMinSamples": 2,
    "impactMinCoverage": 0.5
  },
  "imaging": {
    "checkIntervalMinutes": 30,
    "promos": {
      "enabled": false,
      "checkIntervalMinutes": 30,
      "horizonHours": 18,
      "maxClips": 8
    },
    "beds": {
      "enabled": false,
      "tickIntervalMinutes": 0.1,
      "weatherMinutes": [15, 45],
      "produceLeadMinutes": 4,
      "nextShowLeadMinutes": 5,
      "clipRetentionHours": 2
    }
  },
  "autocue": {
    "targetLufs": -16,
    "maxGainDb": 6.0,
    "checkIntervalMinutes": 60,
    "maxAnalyzePerRun": 100,
    "rampTalk": {
      "enabled": true
