    "adminPassword": "CHANGE_ME",
    "bitrate": 192
  },
  "web": {
    "port": 8000,
    "trustedNetworks": [
      "192.168.1.0/24"
    ],
    "listeners": [
      {
        "username": "CHANGE_ME",
        "password": "CHANGE_ME"
      }
    ],
    "publicPaths": []
  },
  "studio": {
    "users": [
      {
        "username": "CHANGE_ME",
        "password": "CHANGE_ME"
      }
    ]
  },
  "liquidsoap": {
    "telnetHost": "127.0.0.1",
    "telnetPort": 1234,
    "queueId": "dj"
  },
  "plex": {
    "baseUrl": "TBD - use the https://<ip-with-dashes>.<hash>.plex.direct:32400 hostname from Settings > Network, not the raw IP, or TLS cert validation will fail",
    "token": "CHANGE_ME",
    "librarySectionId": "TBD",
    "scrobbleEnabled": true
  },
  "musicLibrary": {
    "plexPathPrefix": "TBD",
    "localMountPath": "/mnt/plex-music"
  },
  "djDrops": {
    "gain": 2.0
  },
  "weather": {
    "url": "https://api.open-meteo.com/v1/forecast",
    "latitude": "TBD",
    "longitude": "TBD",
    "timezone": "TBD"
  },
  "schedule": {
    "scriptLeadTimeMinutes": 120,
    "scriptCheckIntervalMinutes": 15,
    "directLeadTimeMinutes": 15,
    "directCheckIntervalMinutes": 2,
    "prewarmCheckIntervalMinutes": 15,
    "prewarmHorizonMinutes": 1440,
    "nowPlayingCheckIntervalMinutes": 0.1,
    "scheduleWatchIntervalMinutes": 1,
    "maxCatchUpMinutes": 10,
    "minLeadTimeMinutes": 30
  },
  "filler": {
    "poolSize": 200,
    "regenerateIntervalMinutes": 360,
    "maxTrackDurationSeconds": 600,
    "rotation": {
      "maxTracksPerArtist": 30,
      "maxTracksPerArtistAlbum": 5,
      "weightWindowDays": 7,
      "noveltyDays": 7,
      "noveltyBoost": 3
    },
    "clockwheel": {
      "pools": {
        "chill": { "genres": ["chillout", "ambient"], "excludeKeywords": ["metal"] }
      },
      "steps": [
        { "pool": "chill", "count": 1 },
        { "pool": "rotation", "count": 4 }
      ],
      "dayparts": [
        { "from": "22:00", "to": "24:00", "steps": [
          { "pool": "chill", "count": 2 },
          { "pool": "rotation", "count": 2 }
        ] }
      ]
    }
  },
  "shows": {
    "repeatWindowDays": 30,
    "maxTrackDurationSeconds": 300,
    "minTrackDurationSeconds": 120,
    "inventory": {
      "minSpeechSegments": 3,
      "minTracksPer30Minutes": 6
    }
  },
  "cleanup": {
    "retentionDays": 7,
    "intervalMinutes": 360
  },
  "backup": {
    "dir": "TBD - absolute path to a folder (ideally off-box or on separate storage) where daily backups of station.json and show-descriptions/ are written",
    "intervalMinutes": 1440
  },
  "analytics": {
    "sampleIntervalMinutes": 1,
    "maxEntries": 43200,
    "impactWindowHours": 168,
    "impactMinSamples": 2,
    "impactMinCoverage": 0.5
  },
  "imaging": {
    "checkIntervalMinutes": 30
  },
  "autocue": {
    "targetLufs": -16,
    "maxGainDb": 6.0,
    "checkIntervalMinutes": 60,
    "maxAnalyzePerRun": 100
  },
  "broadcast": {
    "tuneIn": null,
    "discordWebhook": null,
    "publicStreamUrl": null
  },
  "scripts": {
    "maxToolIterations": 60,
    "defaultRepeatWindowDays": 7
  },
  "autoRadio": {
    "enabled": false,
    "stationName": "Radio Clyde",
    "music": {
      "source": "auto",
      "localDirs": ["/mnt/plex-music"],
      "audioExtensions": [".mp3", ".flac", ".m4a", ".ogg", ".opus", ".wav"]
    },
    "rules": {
      "artistCooldownHours": 3,
      "popularityMix": { "popularShare": 0.7 },
      "decadeSpread": true,
      "timeOfDayBlocks": {
        "morning": { "start": "05:00", "end": "10:00" },
        "daytime": { "start": "10:00", "end": "17:00" },
        "evening": { "start": "17:00", "end": "23:00" },
        "night": { "start": "23:00", "end": "05:00" }
      }
    },
    "voice": {
      "mode": "edge",
      "edgeVoice": "sl-SI-RokNeural",
      "edgeFallback": "espeak",
      "clipsDir": "voice-clips",
      "defaultEspeakVoice": "sl",
      "personas": {
        "elena": {
          "edgeVoice": "sl-SI-PetraNeural"
        }
      }
    },
    "rubrics": {
      "station": "Ljubljana",
      "newsLimit": 3,
      "sportLimit": 4,
      "onThisDayLimit": 2,
      "timeoutSeconds": 10
    }
  }
}
