[Unit]
Description=Radioclyde (web server, studio admin, and scheduling daemon)
# liquidsoap-radioclyde in After= only: Node needs Icecast up, not Liquidsoap -- a Wants= here could pull-start the stock Debian liquidsoap.service.
After=network.target icecast2.service liquidsoap-radioclyde.service
Wants=icecast2.service

[Service]
Type=simple
User=ai
Group=ai
WorkingDirectory=/home/ai/radioclyde
ExecStart=/home/ai/.nvm/versions/node/v24.18.0/bin/node /home/ai/radioclyde/src/server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
