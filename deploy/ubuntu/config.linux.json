{
  "dataDir": "/opt/radioclyde/data",
  "autoRadio": {
    "enabled": true,
    "stationName": "Radio Clyde",
    "music": {
      "source": "local",
      "localDirs": [
        "/opt/radioclyde/music"
      ],
      "audioExtensions": [
        ".mp3",
        ".flac",
        ".m4a",
        ".ogg",
        ".opus",
        ".wav"
      ]
    },
    "rules": {
      "artistCooldownHours": 3,
      "popularityMix": {
        "popularShare": 0.7
      },
      "decadeSpread": true,
      "timeOfDayBlocks": {
        "morning": { "start": "05:00", "end": "10:00" },
        "daytime": { "start": "10:00", "end": "17:00" },
        "evening": { "start": "17:00", "end": "23:00" },
        "night": { "start": "23:00", "end": "05:00" }
      }
    },
    "voice": {
      "mode": "pregenerated",
      "clipsDir": "voice-clips",
      "defaultEspeakVoice": "sl",
      "defaultPiperVoice": "/opt/radioclyde/voices/sl_SI-artur-medium.onnx",
      "pythonPath": "python3",
      "personas": {}
    }
  },
  "shows": {
    "repeatWindowDays": 30,
    "maxTrackDurationSeconds": 300,
    "minTrackDurationSeconds": 120
  },
  "schedule": {
    "scriptLeadTimeMinutes": 120,
    "scriptCheckIntervalMinutes": 15,
    "directLeadTimeMinutes": 15,
    "directCheckIntervalMinutes": 2,
    "prewarmCheckIntervalMinutes": 15,
    "prewarmHorizonMinutes": 1440,
    "nowPlayingCheckIntervalMinutes": 0.1,
    "scheduleWatchIntervalMinutes": 1,
    "maxCatchUpMinutes": 10,
    "minLeadTimeMinutes": 30
  },
  "filler": {
    "poolSize": 200,
    "regenerateIntervalMinutes": 360,
    "maxTrackDurationSeconds": 600,
    "rotationWindowHours": 24
  },
  "cleanup": {
    "retentionDays": 7,
    "intervalMinutes": 360
  },
  "backup": {
    "dir": "/opt/radioclyde/backups",
    "intervalMinutes": 1440
  },
  "analytics": {
    "sampleIntervalMinutes": 1,
    "maxEntries": 43200,
    "impactWindowHours": 168,
    "impactMinSamples": 2,
    "impactMinCoverage": 0.5
  },
  "broadcast": {
    "tuneIn": null,
    "discordWebhook": null,
    "publicStreamUrl": null
  },
  "liquidsoap": {
    "telnetHost": "127.0.0.1",
    "telnetPort": 1234,
    "queueId": "dj"
  },
  "weather": {
    "url": "https://api.open-meteo.com/v1/forecast",
    "latitude": 46.0569,
    "longitude": 14.5058,
    "timezone": "Europe/Ljubljana",
    "temperatureUnit": "celsius",
    "windSpeedUnit": "kmh"
  },
  "djDrops": {
    "gain": 1
  },
  "web": {
    "port": 3000
  },
  "icecast": {
    "sourceHost": "127.0.0.1",
    "publicHost": "CHANGE_ME_PUBLIC_HOST_OR_IP",
    "port": 8000,
    "mount": "/stream.mp3",
    "sourcePassword": "CHANGE_ME_SOURCE_PASSWORD",
    "adminPassword": "CHANGE_ME_ADMIN_PASSWORD",
    "bitrate": 128
  },
  "plex": {
    "scrobbleEnabled": false
  },
  "scripts": {
    "defaultRepeatWindowDays": 7
  }
}
